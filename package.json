{
  "name": "techverse-x",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo TechVerse X — lihat KERANGKA.md 4.7 untuk struktur yang dituju.",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace web",
    "build:web": "npm run build --workspace web",
    "lint:web": "npm run lint --workspace web",
    "cek:tautan": "node .github/scripts/cek-tautan-markdown.mjs",
    "cek:isi": "node database/isi/pasang.mjs --cek",
    "test:markdown": "node --test apps/web/src/lib/markdown/parse.test.mjs",
    "test:isi": "node --test database/isi/media.test.mjs",
    "cek:halaman": "node .github/scripts/periksa-halaman-web.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
